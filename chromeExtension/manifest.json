{
    "manifest_version": 3,
    "name": "YoutubeVideoSummarizer",
    "description": "Summarized transcripts for YouTube videos.",
    "version": "1.0",
    "permissions": ["activeTab", "tabs"],
    "host_permissions": [
        "http://127.0.0.1:5000/*",
        "http://localhost:5000/*"
    ],
    "action": {
        "default_popup": "popup.html"
    }
}
